{
  "name": "mint-condition",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lookup": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/lookup.ts",
    "hash-password": "node --experimental-strip-types --no-warnings scripts/hash-password.ts",
    "setup:fly": "node --experimental-strip-types --no-warnings scripts/setup-fly.ts"
  },
  "dependencies": {
    "barcode-detector": "^3.2.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
