# Personal access token from https://www.discogs.com/settings/developers
# Must belong to your seller account so price suggestions are returned.
DISCOGS_TOKEN=
# Discogs requires a descriptive User-Agent.
DISCOGS_USER_AGENT=MintCondition/0.1 (+your-email@example.com)
# Optional: set to require a login locally (min 12 characters).
# APP_PASSWORD=
